---
import { languages } from '@/i18n/ui';
import{
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@/i18n/utils.ts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatedPath = useTranslatedPath (lang);   
---
<ul>
  {Object.entries(languages).map(([langPrefix, label]) => {
    if (langPrefix == lang) return <></>
      return (<a href={translatedPath("/", langPrefix)}>{langPrefix.toUpperCase()}</a>)
  })}
</ul>