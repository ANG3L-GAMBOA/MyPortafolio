---
import { navigate } from "astro:transitions/client";
import ThemeToggle from "./ThemeToggle.astro"
import { getRelativeLocaleUrl, getRelativeLocaleUrlList } from "astro:i18n"

import {getLangFromUrl, useTranslations} from '@/i18n/utils.ts'
import  LanguagePicker  from "./LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { currentLocale } = Astro;

const navItems = [
  {
    title: t('nav.experiencia'),
    label: "experiencia",
    url:  '#experiencia',
  },
   {
    title: t('nav.educacion'),
    label: "educacion",
    url: '#educación',
  },
  {
    title: t('nav.proyectos'),
    label: "proyectos",
    url:  '#proyectos',
  },
   {
    title: t('nav.habilidades'),
    label: "habilidades",
    url: '#habilidades',
  },
   {
    title: t('nav.certificados'),
    label: "certificados",
    url: '#certificados',
  },
  {
    title: t('nav.sobre-mi'),
    label: "sobre-mi",
    url: '#sobre-mi',  //
  },
  {
    title: t('nav.contacto'),
    label: "contacto",
    url: "mailto:Angel_juan23@hotmail.com",
  },

]

---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-3 py-2 transition hover:text-blue-500 dark:hover:text-blue-500"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    
    <LanguagePicker />

    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = [...document.querySelectorAll("section[id]")]
    const navItems = [...document.querySelectorAll("header nav a[href^='#']")]

function setActiveSection() {
  let currentSectionId: string = ""
  let minDistance = Infinity

  const scrollBottom =
    window.innerHeight + window.scrollY >= document.body.offsetHeight - 10

  sections.forEach((section: HTMLElement) => {
    const rect = section.getBoundingClientRect()
    const distance = Math.abs(rect.top)

    if (rect.top <= 120 && distance < minDistance) {
      minDistance = distance
      currentSectionId = section.id
    }
  })

  if (scrollBottom && sections.length > 0) {
    currentSectionId = sections[sections.length - 1].id
  }

  navItems.forEach((item: HTMLAnchorElement) => {
    const href = item.getAttribute("href")
    const hash = href ? href.replace("#", "") : ""

    item.classList.toggle("text-blue-500", hash === currentSectionId)
  })
}


    window.addEventListener("scroll", setActiveSection, { passive: true })
    setActiveSection()
  })
</script>


<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
