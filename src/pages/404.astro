---
import Layout from "../layouts/Layout.astro"; // Verifica que esta ruta sea correcta
---

<Layout title="Portafolio app | error 404" description="Página no encontrada.">
  <main class="flex items-center justify-center min-h-screen bg-gray-900 px-4">
    <div class="text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-yellow-400">404 - Page not found</h1>
      <p class="text-white mt-4">
        Revisar la URL a la que apunta y si está mal escrita, corregirla.
      </p>
      <div class="pt-10">
        <a href="/" class="rounded-md bg-white text-black mx-auto p-4 hover:border-4 border-yellow-400">
          Volver Inicio
        </a>
      </div>
    </div>
  </main>
</Layout>
