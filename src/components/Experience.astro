---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [

  {
    date: "Septiembre 2023",
    title: "Practicante Porfesional Full Stack",
    company: "Digital Buho SAC",
    description:
      "Practicas profesional, enfocado en creación y uso de las herramientas brindadas con el fin de desarrollarme mi capacidad profesional y así poder aportar. Mejora de un 30% en la entrega de trabajos/tareas, gracias a los sistemas automatizados, trabajo en equipo, repositorios, herramientas de versiones.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
